{
  "name": "terrapin-events",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "c8 --all --include=\"lib/*.js\" --check-coverage --per-file --statements=80 npm test",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neon/config": "^1.14.4",
    "@neon/env": "^2.1.7",
    "@node-rs/argon2": "^2.2.2",
    "next": "^16.4.6",
    "pg": "^8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "c8": "^9.1.0"
  }
}
